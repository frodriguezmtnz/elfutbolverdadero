---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import WhatsappIcon from './icons/WhatsappIcon.astro';
import XIcon from './icons/XIcon.astro';
import { social } from '../config/social';

const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-primary text-primary-foreground">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-4 py-9 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left"
  >
    <div>
      <span class="mb-3 inline-flex rounded-xl bg-card p-1.5 shadow-md">
        <Logo class="h-11 w-auto" label="El Fútbol Verdadero" />
      </span>
      <p class="font-heading font-semibold text-2xl uppercase">El Fútbol Verdadero</p>
      <p class="mt-1 text-sm text-primary-foreground">Entrenar, pensar, compartir.</p>
      <p class="mt-3 text-xs text-primary-foreground/70">© {year} El Fútbol Verdadero</p>
    </div>
    <nav
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold"
      aria-label="Enlaces de pie de página"
    >
      <a class="hover:text-accent" href="/colaboraciones/">Colaboraciones</a>
      <a class="hover:text-accent" href="/futbolverdadero-acerca-de/">Acerca de</a>
      <a class="hover:text-accent" href="/rss.xml">RSS</a>
      <a class="hover:text-accent" href="/politica-de-privacidad/">Política de privacidad</a>
    </nav>
    <div class="flex items-center justify-center gap-5">
      <a
        class="transition hover:text-accent"
        href={social.facebook}
        aria-label="Facebook de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <FacebookIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.instagram}
        aria-label="Instagram de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <InstagramIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.x}
        aria-label="X de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <XIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.whatsapp}
        aria-label="Grupo de WhatsApp de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsappIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={`mailto:${social.email}`}
        aria-label="Email de El Fútbol Verdadero"
      >
        <Icon name="mail" class="text-xl" />
      </a>
    </div>
  </div>
</footer>
