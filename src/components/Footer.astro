---
import Icon from './Icon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import WhatsappIcon from './icons/WhatsappIcon.astro';
import XIcon from './icons/XIcon.astro';
import { social } from '../config/social';

const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-primary text-primary-foreground">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-9 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div>
      <p class="font-heading font-semibold text-2xl uppercase">El Fútbol Verdadero</p>
      <p class="mt-1 text-sm text-primary-foreground">Entrenar, pensar, compartir.</p>
    </div>
    <div class="flex flex-wrap items-center gap-5 text-sm font-semibold">
      <a
        class="transition hover:text-accent"
        href={social.facebook}
        aria-label="Facebook de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <FacebookIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.instagram}
        aria-label="Instagram de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <InstagramIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.x}
        aria-label="X de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <XIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={social.whatsapp}
        aria-label="Grupo de WhatsApp de El Fútbol Verdadero"
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsappIcon class="text-xl" />
      </a>
      <a
        class="transition hover:text-accent"
        href={`mailto:${social.email}`}
        aria-label="Email de El Fútbol Verdadero"
      >
        <Icon name="mail" class="text-xl" />
      </a>
      <a class="hover:text-accent" href="/colaboraciones/">Colaboraciones</a>
      <a class="hover:text-accent" href="#">Política de privacidad</a>
    </div>
    <p class="text-xs text-primary-foreground">© {year} El Fútbol Verdadero</p>
  </div>
</footer>
