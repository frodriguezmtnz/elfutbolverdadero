---
import Icon from './Icon.astro';
import { urlFor } from '../lib/images';
import type { Publicacion } from '../lib/sanity';

interface Props {
  pub: Publicacion;
}

const { pub } = Astro.props;

const badge = pub.categorias?.[0]?.name;
const imagen = pub.mainImage?.asset ? urlFor(pub.mainImage.asset, 1280) : null;
const altImagen = pub.mainImage?.alt || pub.title;
const pieImagen = pub.mainImage?.caption;

const lectura = pub.readingTime
  ? /^\d+$/.test(String(pub.readingTime).trim())
    ? `${String(pub.readingTime).trim()} min de lectura`
    : String(pub.readingTime)
  : null;
---

<section class="bg-primary text-primary-foreground">
  <div class="mx-auto grid max-w-7xl gap-0 px-4 py-8 lg:grid-cols-[0.85fr_1.15fr] lg:px-8 lg:py-12">
    <div class="flex flex-col justify-between border-b border-primary-foreground p-6 sm:p-8 lg:border-b-0 lg:border-r lg:p-10">
      <div>
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-tertiary"></span>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground">Entrevista de la semana</p>
        </div>
        {
          badge && (
            <span class="mt-7 inline-flex rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent-foreground">
              {badge}
            </span>
          )
        }
        <h1 class="mt-5 font-heading text-2xl font-bold uppercase leading-none sm:text-5xl">
          <a href={`/${pub.slug}/`}>{pub.title}</a>
        </h1>
        {pub.description && <p class="mt-5 max-w-xl text-base leading-7 text-primary-foreground">{pub.description}</p>}
      </div>

      <div class="mt-8 border-t border-primary-foreground pt-5">
        {pub.author?.name && <p class="text-sm font-bold">Por {pub.author.name}</p>}
        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
          {lectura && <p class="text-xs text-primary-foreground">{lectura}</p>}
          <a
            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-card px-4 text-sm font-bold text-foreground shadow-md"
            href={`/${pub.slug}/`}
          >
            Leer entrevista
            <Icon name="arrow-up-right" class="text-lg" />
          </a>
        </div>
      </div>
    </div>

    <div class="relative min-h-80 overflow-hidden lg:min-h-0">
      {imagen && <img src={imagen} alt={altImagen} class="h-full w-full object-cover grayscale" width="1280" height="1280" loading="eager" fetchpriority="high" />}
      <div class="absolute bottom-0 left-0 right-0 flex items-end justify-between bg-primary p-5 text-primary-foreground sm:p-7">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em]">Conversaciones</p>
          {pieImagen && <p class="mt-1 font-heading text-xl font-bold uppercase">{pieImagen}</p>}
        </div>
        <Icon name="quote" class="text-3xl text-tertiary" />
      </div>
    </div>
  </div>
</section>
