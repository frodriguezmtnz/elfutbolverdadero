---
import Icon from './Icon.astro';
import { urlFor, srcsetFor } from '../lib/images';
import { limpiarDescripcion } from '../lib/texto';
import type { Publicacion } from '../lib/sanity';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  pub: Publicacion;
  ctaLabel?: string;
  chipAcento?: boolean;
}

const { pub, ctaLabel = 'Leer conversación', chipAcento = false, ...rest } = Astro.props;

const badge = pub.categorias?.[0]?.name;
const imagen = pub.mainImage?.asset ? urlFor(pub.mainImage.asset, 800) : null;
const imagenSrcset = pub.mainImage?.asset ? srcsetFor(pub.mainImage.asset, [480, 800, 1200]) : null;
const altImagen = pub.mainImage?.alt || pub.title;
const descripcion = limpiarDescripcion(pub.description);
---

<article
  {...rest}
  class="group flex flex-col overflow-hidden rounded-xl bg-card text-card-foreground shadow-md"
>
  <div class="aspect-[16/9] overflow-hidden bg-muted">
    {
      imagen && (
        <img
          src={imagen}
          srcset={imagenSrcset}
          sizes="(min-width: 768px) 405px, 100vw"
          alt={altImagen}
          class="h-full w-full object-cover grayscale transition duration-300 group-hover:scale-[1.03]"
          width="800"
          height="450"
          loading="lazy"
        />
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3">
      {
        badge && (
          <span
            class:list={[
              'rounded-full px-3 py-1 text-xs font-bold',
              chipAcento
                ? 'bg-accent text-accent-foreground'
                : 'bg-secondary text-secondary-foreground',
            ]}
          >
            {badge}
          </span>
        )
      }
      {pub.club && <span class="text-xs font-semibold text-muted-foreground">{pub.club}</span>}
    </div>
    <h3 class="mt-5 font-heading font-semibold text-2xl uppercase leading-tight">
      <a href={`/${pub.slug}/`} class="hover:text-primary">{pub.title}</a>
    </h3>
    {
      descripcion && (
        <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground">{descripcion}</p>
      )
    }
    <a
      class="mt-auto inline-flex min-h-11 items-center gap-2 pt-5 text-sm font-bold text-primary"
      href={`/${pub.slug}/`}
    >
      {ctaLabel}
      <Icon name="arrow-right" class="text-lg transition group-hover:translate-x-1" />
    </a>
  </div>
</article>
