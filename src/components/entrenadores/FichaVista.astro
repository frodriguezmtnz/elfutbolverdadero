---
import Icon from '../Icon.astro';
import PortableText from '../PortableText.astro';
import { urlFor } from '../../lib/images';
import {
  etiquetaJugadores,
  etiquetaDuracion,
  etiquetaEspacio,
  ETIQUETAS_CATEGORIA_EDAD,
} from '../../lib/entrenadores-textos';
import { opcionesTipoTarea } from '../../../sanity/schemas/valoresComunes';
import type { EjercicioFicha } from '../../lib/entrenadores';

interface Props {
  ej: EjercicioFicha;
  completa: boolean;
}

const { ej, completa } = Astro.props;

const tiposTarea = (v?: string | null) =>
  v ? (opcionesTipoTarea.find((t) => t.value === v)?.title ?? v) : null;

const metaFila = [
  { icono: 'users' as const, valor: etiquetaJugadores(ej.jugadoresMin, ej.jugadoresMax) },
  { icono: 'clock' as const, valor: etiquetaDuracion(ej.duracionMin) },
  { icono: 'layout-dashboard' as const, valor: etiquetaEspacio(ej.espacio, ej.espacioMedidas) },
].filter((m) => m.valor);

const edades = (ej.categoriasEdad ?? []).map((c) => ETIQUETAS_CATEGORIA_EDAD[c]).filter(Boolean);
const diagramaUrl = ej.diagrama?.asset ? urlFor(ej.diagrama.asset, 900) : null;
---

<header class="hidden print:block print:px-2 print:pt-2">
  <p class="font-heading text-sm font-semibold uppercase">
    El Fútbol Verdadero · Entrenadores — ficha de «{ej.title}»
  </p>
</header>

<section class="bg-primary text-primary-foreground">
  <div class="mx-auto max-w-5xl px-4 py-9 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">
      <a class="hover:underline" href="/entrenadores/ejercicios/">
        Banco de ejercicios
      </a>
    </p>
    <h1 class="mt-3 font-heading text-2xl font-semibold uppercase leading-none sm:text-4xl">
      {ej.title}
    </h1>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs font-bold uppercase">
      {(ej.categorias ?? []).map((c) => (
        <span class="rounded-full bg-accent px-3 py-1 text-accent-foreground">{c.name}</span>
      ))}
      {tiposTarea(ej.tipoTarea) && (
        <span class="rounded-full bg-primary-foreground/15 px-3 py-1">
          {tiposTarea(ej.tipoTarea)}
        </span>
      )}
      <span
        class:list={{
          'inline-flex items-center gap-1 rounded-full px-3 py-1': true,
          'bg-accent text-accent-foreground': completa,
          'bg-primary-foreground/15': !completa,
        }}
      >
        {!completa && <Icon name="lock" class="text-sm" />}
        {ej.acceso === 'premium' ? 'Premium' : 'Gratis'}
      </span>
      {completa && (
        <button
          type="button"
          data-imprimir
          class="no-print inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent px-4 text-sm font-bold text-accent-foreground hover:brightness-95"
        >
          <Icon name="pen-line" />
          Descargar ficha (imprimir / PDF)
        </button>
      )}
    </div>
  </div>
</section>

{!completa ? (
  <section class="bg-muted">
    <div class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-heading text-lg font-semibold uppercase">Qué necesitas saber</h2>
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground">
            {metaFila.map((m) => (
              <li class="inline-flex items-center gap-1.5">
                <Icon name={m.icono} class="text-base text-primary" />
                {m.valor}
              </li>
            ))}
          </ul>
          {edades.length > 0 && (
            <p class="mt-2 text-sm text-muted-foreground">Para: {edades.join(', ')}</p>
          )}
          {ej.resumen && <p class="mt-4 text-sm leading-7">{ej.resumen}</p>}
          {(ej.objetivos ?? []).length > 0 && (
            <p class="mt-4 text-sm text-muted-foreground">
              Objetivos:{' '}
              <strong class="text-foreground">
                {ej.objetivos?.map((o) => o.name).join(' · ')}
              </strong>
            </p>
          )}
          <div class="mt-6 overflow-hidden rounded-lg bg-muted p-8 text-center">
            <Icon name="lock" class="text-2xl text-tertiary-ink" />
            <p class="mt-2 text-sm font-bold uppercase text-tertiary-ink">
              Desarrollo, claves del entrenador, errores, variantes y diagrama
            </p>
            <p class="mt-1 text-xs text-muted-foreground">forman parte de la zona premium</p>
          </div>
        </div>
        <div class="flex flex-col gap-4 rounded-xl bg-tertiary p-6 text-tertiary-foreground">
          <p class="font-heading text-xl font-semibold uppercase leading-tight">
            Llévate esta ficha al campo
          </p>
          <p class="text-sm leading-6">
            12 € al año · menos de 1 € al mes. Con tu suscripción se desbloquean el desarrollo
            completo, las claves, los errores frecuentes, las variantes y la ficha imprimible.
          </p>
          <a
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-card px-5 text-sm font-bold text-tertiary"
            href="/entrenadores/suscribirse/"
          >
            Suscribirme
            <Icon name="layout-arrow-right" class="text-lg" />
          </a>
          <a class="text-center text-sm font-bold underline" href="/entrenadores/acceder/">
            Ya soy socio: acceder
          </a>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="bg-muted">
    <div class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
        <article class="rounded-xl border border-border bg-card p-6 sm:p-8">
          {ej.resumen && <p class="text-base leading-7 font-semibold">{ej.resumen}</p>}

          <h2 class="mt-6 font-heading text-lg font-semibold uppercase">Desarrollo</h2>
          <div class="mt-3 space-y-3 text-sm leading-7">
            <PortableText blocks={ej.desarrollo ?? []} />
          </div>

          {diagramaUrl && (
            <figure class="mt-6">
              <img
                class="w-full rounded-lg border border-border"
                src={diagramaUrl}
                alt={ej.diagrama?.alt ?? `Diagrama de ${ej.title}`}
                loading="lazy"
              />
            </figure>
          )}

          {(ej.variantes ?? []).length > 0 && (
            <div class="mt-6">
              <h2 class="font-heading text-lg font-semibold uppercase">Variantes</h2>
              <ul class="mt-3 space-y-2 text-sm leading-6">
                {ej.variantes?.map((v) => (
                  <li class="flex gap-2">
                    <Icon name="arrow-right" class="mt-1 shrink-0 text-primary" />
                    <span>{v}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>

        <aside class="flex flex-col gap-5">
          <div class="rounded-xl border border-border bg-card p-5">
            <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary-ink">La ficha</h2>
            <dl class="mt-3 space-y-2 text-sm">
              {metaFila.map((m) => (
                <div class="flex items-center gap-2">
                  <Icon name={m.icono} class="text-base text-primary" />
                  <dd>{m.valor}</dd>
                </div>
              ))}
              {edades.length > 0 && (
                <div class="flex items-start gap-2">
                  <Icon name="users" class="mt-0.5 text-base text-primary" />
                  <dd>{edades.join(', ')}</dd>
                </div>
              )}
              {(ej.material ?? []).length > 0 && (
                <div class="flex items-start gap-2">
                  <Icon name="layout-dashboard" class="mt-0.5 text-base text-primary" />
                  <dd>{ej.material?.join(', ')}</dd>
                </div>
              )}
            </dl>
          </div>

          {(ej.claves ?? []).length > 0 && (
            <div class="rounded-xl bg-primary p-5 text-primary-foreground">
              <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">
                Claves del entrenador
              </h2>
              <ul class="mt-3 space-y-2 text-sm leading-6">
                {(ej.claves ?? []).map((k, i) => (
                  <li class="flex gap-2">
                    <span class="font-heading font-semibold text-accent">{i + 1}.</span>
                    <span>{k}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {(ej.errores ?? []).length > 0 && (
            <div class="rounded-xl border border-border bg-card p-5">
              <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-destructive">
                Errores frecuentes
              </h2>
              <ul class="mt-3 space-y-2 text-sm leading-6 text-muted-foreground">
                {(ej.errores ?? []).map((e) => (
                  <li class="flex gap-2">
                    <span class="text-destructive" aria-hidden="true">
                      ×
                    </span>
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
)}
