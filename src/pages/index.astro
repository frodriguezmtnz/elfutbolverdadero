---
import Base from '../layouts/Base.astro';
import { getPublicaciones } from '../lib/sanity';

const publicaciones = await getPublicaciones();
---

<Base title="Futbolverdadero · El fútbol del patio de colegio">
  <main>
    <h1>Futbolverdadero</h1>
    <p>El fútbol del patio de colegio.</p>

    <section>
      <h2>Publicaciones</h2>
      {publicaciones.length === 0 ? (
        <p>No hay publicaciones todavía en Sanity ({import.meta.env.SANITY_DATASET ?? 'staging'}).</p>
      ) : (
        <ul>
          {publicaciones.map((p) => (
            <li>
              <article>
                <h3>
                  <a href={`/${p.slug}/`}>{p.title}</a>
                </h3>
                <p>{p.description}</p>
                {p.publishedAt && (
                  <time datetime={p.publishedAt}>
                    {new Date(p.publishedAt).toLocaleDateString('es-ES')}
                  </time>
                )}
              </article>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Base>