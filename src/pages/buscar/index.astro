---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileNav from '../../components/MobileNav.astro';
import PizarraTactica from '../../components/PizarraTactica.astro';
---

<Base
  title="Buscar — El Fútbol Verdadero"
  description="Busca en todas las entrevistas, artículos y opiniones de El Fútbol Verdadero: título, resumen, etiquetas y texto completo."
  robots="noindex, follow"
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1 bg-muted">
      <section>
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary-ink">Buscador</p>
            <h1 class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">Buscar</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
              Busca en todas las entrevistas, artículos y opiniones: título, resumen, etiquetas y
              texto completo.
            </p>
          </div>

          <form action="/buscar/" method="get" role="search" class="mt-8 flex gap-2">
            <input
              id="q"
              name="q"
              type="search"
              placeholder="Ej: presión, fútbol sala, entrenadoras…"
              aria-label="Buscar en la web"
              autocomplete="off"
              class="min-h-11 w-full rounded-lg border border-border bg-background px-4 text-sm font-medium text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
            <button
              type="submit"
              class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-bold text-primary-foreground"
            >
              Buscar
            </button>
          </form>

          <noscript>
            <p class="mt-4 text-sm text-muted-foreground">
              Activa JavaScript para ver los resultados aquí.
            </p>
          </noscript>

          <div id="sin-resultados" class="mt-10 flex justify-center" hidden>
            <PizarraTactica class="w-56 sm:w-72" />
          </div>

          <p id="estado" class="mt-6 text-sm font-semibold text-muted-foreground" hidden></p>

          <div id="resultados" class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
          </div>

          <nav id="paginacion" class="mt-10" aria-label="Paginación" hidden></nav>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>

<script>
  import type { ItemBusqueda, ItemCuerpo } from '../../lib/busqueda';
  import { limpiarDescripcion } from '../../lib/limpieza';

  interface CacheBusqueda {
    meta: ItemBusqueda[] | null;
    cuerpo: Map<string, string> | null;
  }
  // El ClientRouter re-ejecuta el script en cada navegación, pero `window` persiste:
  // guardamos aquí los índices para no volver a descargarlos al paginar.
  const g = window as unknown as { __efsBusqueda?: CacheBusqueda };
  const cache: CacheBusqueda = (g.__efsBusqueda ??= { meta: null, cuerpo: null });
  let cargandoCuerpo: Promise<Map<string, string>> | null = null;

  const PAGE_SIZE = 12;
  let ultimaCoincidencias: { item: ItemBusqueda; puntos: number }[] = [];
  let paginaActual = 1;
  let consultaActual = '';
  let terminosActuales: string[] = [];

  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  async function cargarIndice(): Promise<ItemBusqueda[]> {
    if (!cache.meta) {
      const res = await fetch('/busqueda.json');
      if (!res.ok) throw new Error('No se pudo cargar el índice de búsqueda');
      cache.meta = (await res.json()) as ItemBusqueda[];
    }
    return cache.meta;
  }

  function cargarCuerpo(): Promise<Map<string, string>> {
    if (!cache.cuerpo) {
      if (!cargandoCuerpo) {
        cargandoCuerpo = (async () => {
          const res = await fetch('/busqueda-cuerpo.json');
          if (!res.ok) throw new Error('No se pudo cargar el texto completo');
          const items = (await res.json()) as ItemCuerpo[];
          cache.cuerpo = new Map(items.map((i) => [i.slug, i.bodyText ?? '']));
          return cache.cuerpo;
        })();
      }
      return cargandoCuerpo;
    }
    return Promise.resolve(cache.cuerpo);
  }

  function puntuar(item: ItemBusqueda, terminos: string[], cuerpoTexto: string): number {
    const titulo = normalizar(item.title ?? '');
    const descripcion = normalizar(item.description ?? '');
    const cuerpo = normalizar(cuerpoTexto);
    const meta = normalizar(
      [item.club, item.tipo, ...(item.categorias ?? []), ...(item.etiquetas ?? [])]
        .filter((v) => typeof v === 'string')
        .join(' '),
    );

    let total = 0;
    for (const t of terminos) {
      let mejor = 0;
      if (titulo.includes(t)) mejor = Math.max(mejor, 100);
      if (meta.length > 0 && meta.includes(t)) mejor = Math.max(mejor, 40);
      if (descripcion.includes(t)) mejor = Math.max(mejor, 10);
      if (cuerpo.includes(t)) mejor = Math.max(mejor, 2);
      if (mejor === 0) return 0;
      total += mejor;
    }
    return total;
  }

  function recorte(
    item: ItemBusqueda,
    terminos: string[],
    cuerpoTexto: string,
  ): string | undefined {
    const fuente =
      limpiarDescripcion(item.description) ||
      limpiarDescripcion((cuerpoTexto ?? '').replace(/\s+/g, ' ').trim()) ||
      '';
    if (!fuente) return undefined;
    const norm = normalizar(fuente);
    let pos = -1;
    for (const t of terminos) {
      const i = norm.indexOf(t);
      if (i !== -1 && (pos === -1 || i < pos)) pos = i;
    }
    if (pos === -1) return fuente.slice(0, 200) + (fuente.length > 200 ? '…' : '');
    const inicio = Math.max(0, pos - 60);
    const fin = Math.min(fuente.length, pos + 160);
    return (
      (inicio > 0 ? '…' : '') + fuente.slice(inicio, fin).trim() + (fin < fuente.length ? '…' : '')
    );
  }

  function fechaCorta(iso?: string): string | null {
    if (!iso) return null;
    const fecha = new Date(iso);
    if (Number.isNaN(fecha.getTime())) return null;
    return fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function urlImagen(url?: string): string | null {
    if (!url) return null;
    return url.includes('?') ? url : `${url}?w=800&auto=format`;
  }

  function crearTarjeta(item: ItemBusqueda, terminos: string[], cuerpoTexto: string): HTMLElement {
    const tarjeta = document.createElement('article');
    tarjeta.className =
      'group flex flex-col overflow-hidden rounded-xl bg-card text-card-foreground shadow-md';

    const src = urlImagen(item.imagen);
    if (src) {
      const contenedor = document.createElement('div');
      contenedor.className = 'aspect-[16/9] overflow-hidden bg-muted';
      const img = document.createElement('img');
      img.src = src;
      img.alt = item.alt || item.title;
      img.className =
        'h-full w-full object-cover grayscale transition duration-300 group-hover:scale-[1.03]';
      img.width = 800;
      img.height = 450;
      img.loading = 'lazy';
      contenedor.append(img);
      tarjeta.append(contenedor);
    }

    const cuerpo = document.createElement('div');
    cuerpo.className = 'flex flex-1 flex-col p-6';

    const fila = document.createElement('div');
    fila.className = 'flex items-center justify-between gap-3';
    const badge = item.categorias?.[0] ?? item.tipo;
    if (badge) {
      const chip = document.createElement('span');
      chip.className =
        'rounded-full bg-secondary px-3 py-1 text-xs font-bold text-secondary-foreground';
      chip.textContent = badge;
      fila.append(chip);
    }
    const fecha = fechaCorta(item.publishedAt);
    if (fecha) {
      const spanFecha = document.createElement('span');
      spanFecha.className = 'text-xs font-semibold text-muted-foreground';
      spanFecha.textContent = fecha;
      fila.append(spanFecha);
    }
    cuerpo.append(fila);

    const h3 = document.createElement('h2');
    h3.className = 'mt-5 font-heading font-semibold text-2xl uppercase leading-tight';
    const enlaceTitulo = document.createElement('a');
    enlaceTitulo.href = `/${item.slug}/`;
    enlaceTitulo.className = 'hover:text-primary';
    enlaceTitulo.textContent = item.title;
    h3.append(enlaceTitulo);
    cuerpo.append(h3);

    const fragmento = recorte(item, terminos, cuerpoTexto);
    if (fragmento) {
      const p = document.createElement('p');
      p.className = 'mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground';
      p.textContent = fragmento;
      cuerpo.append(p);
    }

    const cta = document.createElement('a');
    cta.href = `/${item.slug}/`;
    cta.className =
      'mt-auto inline-flex min-h-11 items-center gap-2 pt-5 text-sm font-bold text-primary';
    cta.textContent = 'Leer';
    cta.insertAdjacentHTML(
      'beforeend',
      '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-lg transition group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>',
    );
    cuerpo.append(cta);

    tarjeta.append(cuerpo);
    return tarjeta;
  }

  function svgIcono(paths: string, clase: string): string {
    return `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${clase}" aria-hidden="true">${paths}</svg>`;
  }
  const ARROW_LEFT = `<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>`;
  const ARROW_RIGHT = `<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>`;

  function totalPaginas(): number {
    return Math.max(1, Math.ceil(ultimaCoincidencias.length / PAGE_SIZE));
  }

  function clampPagina(): void {
    paginaActual = Math.min(Math.max(1, paginaActual), totalPaginas());
  }

  function leerPaginaURL(): number {
    const params = new URLSearchParams(window.location.search);
    const n = parseInt(params.get('p') ?? '1', 10);
    return Number.isFinite(n) && n >= 1 ? n : 1;
  }

  function urlBusqueda(q: string, p: number): string {
    const params = new URLSearchParams();
    params.set('q', q);
    if (p > 1) params.set('p', String(p));
    return `/buscar/?${params.toString()}`;
  }

  function construirPaginacion(): void {
    const nav = document.getElementById('paginacion');
    if (!nav) return;

    const totalPages = totalPaginas();
    if (ultimaCoincidencias.length === 0 || totalPages <= 1) {
      nav.hidden = true;
      nav.replaceChildren();
      return;
    }
    nav.hidden = false;

    const numeros: (number | 'elipsis')[] = [];
    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || Math.abs(i - paginaActual) <= 1) {
        numeros.push(i);
      } else if (numeros[numeros.length - 1] !== 'elipsis') {
        numeros.push('elipsis');
      }
    }

    const claseEnlace =
      'inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-border bg-card px-3 text-sm font-semibold text-muted-foreground transition-colors hover:border-primary hover:text-primary';
    const claseNumero =
      'inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-card text-sm font-semibold text-muted-foreground transition-colors hover:border-primary hover:text-primary';
    const claseActual =
      'inline-flex h-11 w-11 items-center justify-center rounded-lg bg-primary text-sm font-bold text-primary-foreground';
    const claseDesactivado =
      'inline-flex min-h-11 cursor-not-allowed items-center rounded-lg border border-border px-3 text-sm font-semibold text-muted-foreground/50';

    const frag = document.createDocumentFragment();
    const envoltorio = document.createElement('div');
    envoltorio.className = 'flex flex-wrap items-center gap-2';

    if (paginaActual > 1) {
      envoltorio.insertAdjacentHTML(
        'beforeend',
        `<a href="${urlBusqueda(consultaActual, paginaActual - 1)}" rel="prev" class="${claseEnlace}">${svgIcono(ARROW_LEFT, 'text-base')}Anterior</a>`,
      );
    } else {
      envoltorio.insertAdjacentHTML(
        'beforeend',
        `<span class="${claseDesactivado}" aria-disabled="true">Anterior</span>`,
      );
    }

    const numerosDiv = document.createElement('div');
    numerosDiv.className = 'flex flex-wrap items-center gap-1';
    for (const n of numeros) {
      if (n === 'elipsis') {
        numerosDiv.insertAdjacentHTML(
          'beforeend',
          '<span class="px-1.5 text-sm text-muted-foreground" aria-hidden="true">…</span>',
        );
      } else if (n === paginaActual) {
        numerosDiv.insertAdjacentHTML(
          'beforeend',
          `<span aria-current="page" class="${claseActual}">${n}</span>`,
        );
      } else {
        numerosDiv.insertAdjacentHTML(
          'beforeend',
          `<a href="${urlBusqueda(consultaActual, n)}" class="${claseNumero}">${n}</a>`,
        );
      }
    }
    envoltorio.append(numerosDiv);

    if (paginaActual < totalPages) {
      envoltorio.insertAdjacentHTML(
        'beforeend',
        `<a href="${urlBusqueda(consultaActual, paginaActual + 1)}" rel="next" class="${claseEnlace}">Siguiente${svgIcono(ARROW_RIGHT, 'text-base')}</a>`,
      );
    } else {
      envoltorio.insertAdjacentHTML(
        'beforeend',
        `<span class="${claseDesactivado}" aria-disabled="true">Siguiente</span>`,
      );
    }

    frag.append(envoltorio);
    nav.replaceChildren(frag);
  }

  function pintarPagina(): void {
    const estado = document.getElementById('estado');
    const contenedor = document.getElementById('resultados');
    const vacio = document.getElementById('sin-resultados');
    if (!estado || !contenedor) return;

    clampPagina();
    const total = ultimaCoincidencias.length;
    const inicio = (paginaActual - 1) * PAGE_SIZE;
    const fin = Math.min(inicio + PAGE_SIZE, total);
    const ventana = ultimaCoincidencias.slice(inicio, fin);

    contenedor.replaceChildren();
    for (const { item } of ventana) {
      contenedor.append(crearTarjeta(item, terminosActuales, cache.cuerpo?.get(item.slug) ?? ''));
    }

    if (vacio) vacio.hidden = total > 0;

    if (total === 0) {
      estado.textContent = `Sin resultados para «${consultaActual}». Prueba con otras palabras.`;
    } else if (totalPaginas() > 1) {
      estado.textContent = `Mostrando ${inicio + 1}–${fin} de ${total} ${total === 1 ? 'resultado' : 'resultados'} para «${consultaActual}»`;
    } else {
      estado.textContent = `${total} ${total === 1 ? 'resultado' : 'resultados'} para «${consultaActual}»`;
    }

    construirPaginacion();
  }

  async function buscar() {
    const input = document.getElementById('q') as HTMLInputElement | null;
    const estado = document.getElementById('estado');
    const contenedor = document.getElementById('resultados');
    const vacio = document.getElementById('sin-resultados');
    if (!input || !estado || !contenedor) return;

    const params = new URLSearchParams(window.location.search);
    const consulta = (params.get('q') ?? input.value).trim();
    if (consulta && input.value !== consulta) {
      input.value = consulta;
    }
    contenedor.replaceChildren();

    if (!consulta) {
      estado.hidden = true;
      if (vacio) vacio.hidden = true;
      const nav = document.getElementById('paginacion');
      if (nav) {
        nav.hidden = true;
        nav.replaceChildren();
      }
      return;
    }

    estado.hidden = false;
    estado.textContent = 'Buscando…';
    if (vacio) vacio.hidden = true;

    const contenedorEl: HTMLElement = contenedor;

    // Reservar espacio para los resultados y evitar saltos de layout (CLS)
    contenedorEl.style.minHeight = `${Math.round(window.innerHeight * 0.5)}px`;

    consultaActual = consulta;
    paginaActual = leerPaginaURL();

    try {
      const indice = await cargarIndice();
      const terminos = normalizar(consulta).split(/\s+/).filter(Boolean);
      terminosActuales = terminos;

      function calcularCoincidencias(cuerpoMap: Map<string, string> | null): void {
        ultimaCoincidencias = indice
          .map((item) => ({
            item,
            puntos: puntuar(item, terminos, cuerpoMap?.get(item.slug) ?? ''),
          }))
          .filter((r) => r.puntos > 0)
          .sort((a, b) => b.puntos - a.puntos);
      }

      calcularCoincidencias(cache.cuerpo);
      pintarPagina();

      if (!cache.cuerpo) {
        cargarCuerpo()
          .then((map) => {
            const consultaVigente = (
              new URLSearchParams(window.location.search).get('q') ?? input.value
            ).trim();
            if (consultaVigente === consulta) {
              // Re-rank con texto completo conservando la página actual.
              calcularCoincidencias(map);
              pintarPagina();
            }
          })
          .catch(() => {
            /* sin texto completo: se mantienen los resultados de metadatos */
          });
      }
    } catch {
      if (vacio) vacio.hidden = true;
      estado.textContent = 'No se pudo cargar la búsqueda. Inténtalo de nuevo.';
    }
  }

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('q')) {
      buscar();
    }
  });
</script>
