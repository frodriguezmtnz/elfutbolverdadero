---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileNav from '../../components/MobileNav.astro';
import PizarraTactica from '../../components/PizarraTactica.astro';
---

<Base
  title="Buscar — El Fútbol Verdadero"
  description="Busca en todas las entrevistas, artículos y opiniones de El Fútbol Verdadero: título, resumen, etiquetas y texto completo."
  robots="noindex, follow"
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1 bg-muted">
      <section>
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary">Buscador</p>
            <h1 class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">Buscar</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
              Busca en todas las entrevistas, artículos y opiniones: título, resumen, etiquetas y texto completo.
            </p>
          </div>

          <form action="/buscar/" method="get" role="search" class="mt-8 flex gap-2">
            <input
              id="q"
              name="q"
              type="search"
              placeholder="Ej: presión, fútbol sala, entrenadoras…"
              autocomplete="off"
              class="min-h-11 w-full rounded-lg border border-border bg-background px-4 text-sm font-medium text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
            <button
              type="submit"
              class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-bold text-primary-foreground"
            >
              Buscar
            </button>
          </form>

          <noscript>
            <p class="mt-4 text-sm text-muted-foreground">
              Activa JavaScript para ver los resultados aquí.
            </p>
          </noscript>

          <div id="sin-resultados" class="mt-10 flex justify-center" hidden>
            <PizarraTactica class="w-56 sm:w-72" />
          </div>

          <p id="estado" class="mt-6 text-sm font-semibold text-muted-foreground" hidden></p>

          <div id="resultados" class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3"></div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>

<script>
  import type { ItemBusqueda, ItemCuerpo } from '../../lib/busqueda';
  import { limpiarDescripcion } from '../../lib/limpieza';

  let cacheMeta: ItemBusqueda[] | null = null;
  let cacheCuerpo: Map<string, string> | null = null;
  let cargandoCuerpo: Promise<Map<string, string>> | null = null;

  function normalizar(texto: string): string {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  async function cargarIndice(): Promise<ItemBusqueda[]> {
    if (!cacheMeta) {
      const res = await fetch('/busqueda.json');
      if (!res.ok) throw new Error('No se pudo cargar el índice de búsqueda');
      cacheMeta = (await res.json()) as ItemBusqueda[];
    }
    return cacheMeta;
  }

  function cargarCuerpo(): Promise<Map<string, string>> {
    if (!cacheCuerpo) {
      if (!cargandoCuerpo) {
        cargandoCuerpo = (async () => {
          const res = await fetch('/busqueda-cuerpo.json');
          if (!res.ok) throw new Error('No se pudo cargar el texto completo');
          const items = (await res.json()) as ItemCuerpo[];
          cacheCuerpo = new Map(items.map((i) => [i.slug, i.bodyText ?? '']));
          return cacheCuerpo;
        })();
      }
      return cargandoCuerpo;
    }
    return Promise.resolve(cacheCuerpo);
  }

  function puntuar(item: ItemBusqueda, terminos: string[], cuerpoTexto: string): number {
    const titulo = normalizar(item.title ?? '');
    const descripcion = normalizar(item.description ?? '');
    const cuerpo = normalizar(cuerpoTexto);
    const meta = normalizar(
      [item.club, item.tipo, ...(item.categorias ?? []), ...(item.etiquetas ?? [])]
        .filter((v) => typeof v === 'string')
        .join(' ')
    );

    let total = 0;
    for (const t of terminos) {
      let mejor = 0;
      if (titulo.includes(t)) mejor = Math.max(mejor, 100);
      if (meta.length > 0 && meta.includes(t)) mejor = Math.max(mejor, 40);
      if (descripcion.includes(t)) mejor = Math.max(mejor, 10);
      if (cuerpo.includes(t)) mejor = Math.max(mejor, 2);
      if (mejor === 0) return 0;
      total += mejor;
    }
    return total;
  }

  function recorte(item: ItemBusqueda, terminos: string[], cuerpoTexto: string): string | undefined {
    const fuente =
      limpiarDescripcion(item.description) ||
      limpiarDescripcion((cuerpoTexto ?? '').replace(/\s+/g, ' ').trim()) ||
      '';
    if (!fuente) return undefined;
    const norm = normalizar(fuente);
    let pos = -1;
    for (const t of terminos) {
      const i = norm.indexOf(t);
      if (i !== -1 && (pos === -1 || i < pos)) pos = i;
    }
    if (pos === -1) return fuente.slice(0, 200) + (fuente.length > 200 ? '…' : '');
    const inicio = Math.max(0, pos - 60);
    const fin = Math.min(fuente.length, pos + 160);
    return (
      (inicio > 0 ? '…' : '') +
      fuente.slice(inicio, fin).trim() +
      (fin < fuente.length ? '…' : '')
    );
  }

  function fechaCorta(iso?: string): string | null {
    if (!iso) return null;
    const fecha = new Date(iso);
    if (Number.isNaN(fecha.getTime())) return null;
    return fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function urlImagen(url?: string): string | null {
    if (!url) return null;
    return url.includes('?') ? url : `${url}?w=800&auto=format`;
  }

  function crearTarjeta(item: ItemBusqueda, terminos: string[], cuerpoTexto: string): HTMLElement {
    const tarjeta = document.createElement('article');
    tarjeta.className =
      'group flex flex-col overflow-hidden rounded-xl bg-card text-card-foreground shadow-md';

    const src = urlImagen(item.imagen);
    if (src) {
      const contenedor = document.createElement('div');
      contenedor.className = 'aspect-[16/9] overflow-hidden bg-muted';
      const img = document.createElement('img');
      img.src = src;
      img.alt = item.alt || item.title;
      img.className =
        'h-full w-full object-cover grayscale transition duration-300 group-hover:scale-[1.03]';
      img.width = 800;
      img.height = 450;
      img.loading = 'lazy';
      contenedor.append(img);
      tarjeta.append(contenedor);
    }

    const cuerpo = document.createElement('div');
    cuerpo.className = 'flex flex-1 flex-col p-6';

    const fila = document.createElement('div');
    fila.className = 'flex items-center justify-between gap-3';
    const badge = item.categorias?.[0] ?? item.tipo;
    if (badge) {
      const chip = document.createElement('span');
      chip.className = 'rounded-full bg-secondary px-3 py-1 text-xs font-bold text-secondary-foreground';
      chip.textContent = badge;
      fila.append(chip);
    }
    const fecha = fechaCorta(item.publishedAt);
    if (fecha) {
      const spanFecha = document.createElement('span');
      spanFecha.className = 'text-xs font-semibold text-muted-foreground';
      spanFecha.textContent = fecha;
      fila.append(spanFecha);
    }
    cuerpo.append(fila);

    const h3 = document.createElement('h3');
    h3.className = 'mt-5 font-heading font-semibold text-2xl uppercase leading-tight';
    const enlaceTitulo = document.createElement('a');
    enlaceTitulo.href = `/${item.slug}/`;
    enlaceTitulo.className = 'hover:text-primary';
    enlaceTitulo.textContent = item.title;
    h3.append(enlaceTitulo);
    cuerpo.append(h3);

    const fragmento = recorte(item, terminos, cuerpoTexto);
    if (fragmento) {
      const p = document.createElement('p');
      p.className = 'mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground';
      p.textContent = fragmento;
      cuerpo.append(p);
    }

    const cta = document.createElement('a');
    cta.href = `/${item.slug}/`;
    cta.className =
      'mt-auto inline-flex min-h-11 items-center gap-2 pt-5 text-sm font-bold text-primary';
    cta.textContent = 'Leer';
    cta.insertAdjacentHTML(
      'beforeend',
      '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-lg transition group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>'
    );
    cuerpo.append(cta);

    tarjeta.append(cuerpo);
    return tarjeta;
  }

  async function buscar() {
    const input = document.getElementById('q') as HTMLInputElement | null;
    const estado = document.getElementById('estado');
    const contenedor = document.getElementById('resultados');
    const vacio = document.getElementById('sin-resultados');
    if (!input || !estado || !contenedor) return;

    const params = new URLSearchParams(window.location.search);
    const consulta = (params.get('q') ?? input.value).trim();
    if (consulta && input.value !== consulta) {
      input.value = consulta;
    }
    contenedor.replaceChildren();

    if (!consulta) {
      estado.hidden = true;
      if (vacio) vacio.hidden = true;
      return;
    }

    estado.hidden = false;
    estado.textContent = 'Buscando…';
    if (vacio) vacio.hidden = true;

    const estadoEl: HTMLElement = estado;
    const contenedorEl: HTMLElement = contenedor;

    try {
      const indice = await cargarIndice();
      const terminos = normalizar(consulta).split(/\s+/).filter(Boolean);

      function renderizarResultados(cuerpoMap: Map<string, string> | null): number {
        const coincidencias = indice
          .map((item) => ({ item, puntos: puntuar(item, terminos, cuerpoMap?.get(item.slug) ?? '') }))
          .filter((r) => r.puntos > 0)
          .sort((a, b) => b.puntos - a.puntos);

        contenedorEl.replaceChildren();
        for (const { item } of coincidencias) {
          contenedorEl.append(crearTarjeta(item, terminos, cuerpoMap?.get(item.slug) ?? ''));
        }

        if (vacio) vacio.hidden = coincidencias.length > 0;

        estadoEl.textContent =
          coincidencias.length === 0
            ? `Sin resultados para «${consulta}». Prueba con otras palabras.`
            : `${coincidencias.length} ${coincidencias.length === 1 ? 'resultado' : 'resultados'} para «${consulta}»`;

        return coincidencias.length;
      }

      renderizarResultados(cacheCuerpo);

      if (!cacheCuerpo) {
        cargarCuerpo()
          .then((map) => {
            const consultaActual = (
              new URLSearchParams(window.location.search).get('q') ?? input.value
            ).trim();
            if (consultaActual === consulta) {
              renderizarResultados(map);
            }
          })
          .catch(() => {
            /* sin texto completo: se mantienen los resultados de metadatos */
          });
      }
    } catch {
      if (vacio) vacio.hidden = true;
      estado.textContent = 'No se pudo cargar la búsqueda. Inténtalo de nuevo.';
    }
  }

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('q')) {
      buscar();
    }
  });
</script>
