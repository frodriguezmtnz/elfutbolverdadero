---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import MobileNav from '../../../../components/MobileNav.astro';
import Icon from '../../../../components/Icon.astro';
import SesionVista from '../../../../components/entrenadores/SesionVista.astro';
import Impresion from '../../../../components/entrenadores/Impresion.astro';
import { getSesionBySlug } from '../../../../lib/entrenadores';
import { usuarioActual, crearClienteSupabase } from '../../../../lib/supabase';
import { obtenerMembresia, suscripcionActiva } from '../../../../lib/membresias';
import { puedeVerContenido } from '../../../../lib/acceso-entrenadores';

export const prerender = false;

const { slug } = Astro.params;
const sesion = await getSesionBySlug(slug!);

// Gate por página (decisión pura y testeada): free se abre a todos; premium
// solo con suscripción viva. El desarrollo nunca viaja sin acceso: la ficha
// completa solo se consulta tras este bloque.
let completa = false;
if (sesion) {
  let viva = false;
  if (sesion.acceso === 'premium') {
    const usuario = await usuarioActual(Astro);
    if (usuario) {
      const supabase = crearClienteSupabase(Astro);
      const membresia = await obtenerMembresia(supabase, usuario.email);
      viva = suscripcionActiva(membresia);
    }
  }
  completa = puedeVerContenido(sesion.acceso, viva);
} else {
  Astro.response.status = 404;
}
---

<Base
  title={
    sesion
      ? `${sesion.title} — ${completa ? 'Sesiones completas' : 'Sesión premium'}`
      : 'Sesión no encontrada — Futbolverdadero Entrenadores'
  }
  description={sesion?.objetivoGeneral ?? 'Sesión de entrenamiento de fútbol base.'}
  robots={sesion && completa ? undefined : 'noindex, follow'}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      {sesion ? (
        <SesionVista sesion={sesion} completa={completa} />
      ) : (
        <section class="bg-muted">
          <div class="mx-auto max-w-2xl px-4 py-16 text-center lg:px-8">
            <Icon name="book-open" class="text-3xl text-primary" />
            <h1 class="mt-4 font-heading text-2xl font-semibold uppercase">Sesión no encontrada</h1>
            <p class="mt-3 text-sm text-muted-foreground">
              La sesión que buscas no existe o cambió de nombre. Vuelve al catálogo y prueba con
              otro filtro.
            </p>
            <a
              class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-bold text-primary-foreground"
              href="/entrenadores/sesiones/"
            >
              <Icon name="arrow-left" />
              Volver a sesiones
            </a>
          </div>
        </section>
      )}
    </main>
    <Footer />
    <div class="h-16 lg:hidden no-print" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
<Impresion />
