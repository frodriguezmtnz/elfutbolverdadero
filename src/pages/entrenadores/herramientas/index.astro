---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import MobileNav from '../../../components/MobileNav.astro';
import Icon from '../../../components/Icon.astro';
import EtiquetaAcceso from '../../../components/entrenadores/EtiquetaAcceso.astro';
import { getHerramientas } from '../../../lib/entrenadores';
import { etiquetaFormato } from '../../../lib/entrenadores-textos';

export const prerender = false;

const catalogo = await getHerramientas();
const premium = catalogo.filter((h) => h.acceso === 'premium').length;
---

<Base
  title="Herramientas del entrenador — Futbolverdadero Entrenadores"
  description="Plantillas descargables: sesión de campo, planificación semanal, evaluación del jugador e informe postpartido."
  canonicalURL="/entrenadores/herramientas/"
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <section class="bg-primary text-primary-foreground">
        <div class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">
            <a class="hover:underline" href="/entrenadores/">
              Futbolverdadero Entrenadores
            </a>
          </p>
          <h1 class="mt-2 font-heading text-2xl font-semibold uppercase sm:text-4xl">
            Herramientas del entrenador
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-primary-foreground/90">
            {catalogo.length} plantillas descargables ({premium} premium): rellénalas el lunes,
            imprímelas el martes y no improvises en la banda.
          </p>
        </div>
      </section>

      <section class="bg-muted">
        <div class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
          {catalogo.length === 0 ? (
            <div class="rounded-xl border border-border bg-card p-10 text-center">
              <Icon name="pen-line" class="text-3xl text-primary" />
              <p class="mt-4 text-sm leading-6 text-muted-foreground">
                La biblioteca está a punto de abrirse. Mientras tanto, el banco de ejercicios ya
                está jugando.
              </p>
              <a
                class="mt-4 inline-block text-sm font-bold text-primary hover:underline"
                href="/entrenadores/ejercicios/"
              >
                Ver el banco
              </a>
            </div>
          ) : (
            <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {catalogo.map((h) => {
                const esPremium = h.acceso === 'premium';
                return (
                  <li
                    data-reveal="up"
                    class:list={{
                      'flex flex-col gap-3 rounded-xl border bg-card p-6': true,
                      'shadow-theme': !esPremium,
                      'border-border': esPremium,
                    }}
                  >
                    <div class="flex items-center justify-between gap-2">
                      <EtiquetaAcceso acceso={h.acceso} />
                      <span class="text-xs font-bold uppercase text-muted-foreground">
                        {etiquetaFormato(h.formato)}
                      </span>
                    </div>

                    <h2 class="font-heading text-base font-semibold uppercase leading-tight">
                      <a class="hover:text-primary" href={`/entrenadores/herramientas/${h.slug}/`}>
                        {h.title}
                      </a>
                    </h2>

                    {h.description && (
                      <p class="text-sm leading-6 text-muted-foreground">{h.description}</p>
                    )}

                    {esPremium && (
                      <p class="mt-auto pt-1 text-xs text-muted-foreground">
                        Descarga disponible con tu suscripción.
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          )}

          <div class="mt-10 rounded-xl bg-tertiary p-6 text-tertiary-foreground sm:flex sm:items-center sm:justify-between sm:p-8">
            <div>
              <p class="font-heading text-lg font-semibold uppercase">¿Sin suscripción todavía?</p>
              <p class="mt-1 text-sm">
                12 € al año: menos de 1 € al mes por plantillas, banco y sesiones completas.
              </p>
            </div>
            <a
              class="mt-4 inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-card px-5 text-sm font-bold text-tertiary sm:mt-0"
              href="/entrenadores/suscribirse/"
            >
              Suscribirme
              <Icon name="layout-arrow-right" class="text-lg" />
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
