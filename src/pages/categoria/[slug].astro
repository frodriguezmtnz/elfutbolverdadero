---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Chip from '../../components/Chip.astro';
import EntrevistaCard from '../../components/EntrevistaCard.astro';
import Footer from '../../components/Footer.astro';
import MobileNav from '../../components/MobileNav.astro';
import {
  getCategoriasConConteo,
  getPublicacionesPorCategoria,
  type CategoriaConteo,
} from '../../lib/sanity';

export async function getStaticPaths() {
  const categorias = await getCategoriasConConteo(1);
  return categorias.map((categoria) => ({
    params: { slug: categoria.slug },
    props: { categoria },
  }));
}

interface Props {
  categoria: CategoriaConteo;
}

const { categoria } = Astro.props;
const publicaciones = await getPublicacionesPorCategoria(categoria.slug);
const categorias = (await getCategoriasConConteo(1)).slice(0, 6);
---

<Base
  title={`${categoria.name} — El Fútbol Verdadero`}
  description={`Publicaciones de fútbol base en la categoría ${categoria.name}.`}
>
  <div class="flex min-h-screen flex-col">
    <Header lecturaHref="/entrevistas/" />
    <main class="flex-1">
      <section class="bg-muted">
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary">Categoría</p>
            <h1 class="mt-2 font-heading text-lg font-semibold uppercase sm:text-3xl">{categoria.name}</h1>
            <p class="mt-3 text-sm text-muted-foreground">
              {publicaciones.length}
              {publicaciones.length === 1 ? 'publicación' : 'publicaciones'}
            </p>
          </div>

          <div class="mt-6 flex gap-2 overflow-x-auto pb-2">
            <Chip href="/entrevistas/" label="Todos" />
            {
              categorias.map((c) => (
                <Chip href={`/categoria/${c.slug}/`} label={c.name} activo={c.slug === categoria.slug} />
              ))
            }
          </div>

          {
            publicaciones.length > 0 ? (
              <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
                {publicaciones.map((pub, i) => (
                  <EntrevistaCard pub={pub} ctaLabel="Leer más" chipAcento={i % 3 === 1} />
                ))}
              </div>
            ) : (
              <p class="mt-8 text-sm text-muted-foreground">Todavía no hay publicaciones en esta categoría.</p>
            )
          }

          <div class="mt-10">
            <a class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-primary" href="/entrevistas/">
              Ver todas las entrevistas
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
