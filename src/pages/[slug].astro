---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import EntrevistaCard from '../components/EntrevistaCard.astro';
import PortableText from '../components/PortableText.astro';
import Icon from '../components/Icon.astro';
import { getAllSlugs, getPublicacionBySlug, getUltimasEntrevistas } from '../lib/sanity';
import { urlFor, srcsetFor } from '../lib/images';
import { limpiarDescripcion, tiempoLectura, sinBloquesTiempoLectura } from '../lib/texto';

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPublicacionBySlug(slug!);

if (!post) {
  return Astro.rewrite('/404');
}

const TIPOS: Record<string, string> = {
  entrevista: 'Entrevista',
  articulo: 'Artículo',
  opinion: 'Opinión',
};

const seoTitle = post.seoTitle ?? post.title;
const seoDescription = post.seoDescription ?? limpiarDescripcion(post.description) ?? '';
const ogImage = post.mainImage?.asset?.url;

const tipoLabel = TIPOS[post.tipo] ?? post.tipo;
const descripcion = limpiarDescripcion(post.description);
const body = sinBloquesTiempoLectura(post.body);
const lectura = tiempoLectura(body, post.readingTime);
const fecha = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
const imagenDestacada = post.mainImage?.asset ? urlFor(post.mainImage.asset, 1400) : null;
const imagenDestacadaSrcset = post.mainImage?.asset ? srcsetFor(post.mainImage.asset, [640, 960, 1400, 1920]) : null;
const altImagen = post.mainImage?.alt || post.title;
const pieImagen = post.mainImage?.caption;
const primeraCategoria = post.categorias?.[0];
const masConversaciones = await getUltimasEntrevistas(3, post._id);

const site = Astro.site!;
const canonical = new URL(`/${post.slug}/`, site).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: seoTitle,
    description: seoDescription,
    inLanguage: 'es',
    ...(ogImage ? { image: ogImage } : {}),
    ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
    ...(post.updatedAt || post.publishedAt ? { dateModified: post.updatedAt ?? post.publishedAt } : {}),
    ...(post.author?.name
      ? { author: { '@type': 'Person', name: post.author.name } }
      : {}),
    publisher: {
      '@type': 'Organization',
      name: 'Futbolverdadero',
      url: site.href,
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'La Pizarra', item: new URL('/entrevistas/', site).href },
      ...(primeraCategoria?.slug
        ? [{
            '@type': 'ListItem',
            position: 3,
            name: primeraCategoria.name,
            item: new URL(`/categoria/${primeraCategoria.slug}/`, site).href,
          }]
        : []),
      { '@type': 'ListItem', position: primeraCategoria?.slug ? 4 : 3, name: post.title, item: canonical },
    ],
  },
];
---

<Base
  title={seoTitle}
  description={seoDescription}
  canonicalURL={`/${post.slug}/`}
  image={ogImage}
  type="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt ?? post.publishedAt}
  authorName={post.author?.name}
  categories={post.categorias?.map((c) => c.name) ?? []}
  jsonLd={jsonLd}
>
  <div class="flex min-h-screen flex-col">
    <Header lecturaHref="/entrevistas/" />
    <main class="flex-1">
      <article>
        <header class="bg-background">
          <div data-reveal="up" class="mx-auto max-w-3xl px-4 pt-8 lg:px-8 lg:pt-12">
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
              <nav class="flex items-center gap-2 text-xs font-semibold text-muted-foreground" aria-label="Migas de pan">
                <a class="hover:text-primary" href="/entrevistas/">La Pizarra</a>
                {
                  primeraCategoria && (
                    <>
                      <span>/</span>
                      <a class="hover:text-primary" href={`/categoria/${primeraCategoria.slug}/`}>
                        {primeraCategoria.name}
                      </a>
                    </>
                  )
                }
              </nav>

              {
                (fecha || lectura) && (
                  <div class="flex shrink-0 items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground sm:text-xs">
                    {fecha && (
                      <time datetime={post.publishedAt} class="border-b border-dashed border-border pb-0.5">
                        {fecha}
                      </time>
                    )}
                    {lectura && (
                      <p class="inline-flex items-center gap-1.5">
                        <Icon name="clock" class="text-[13px]" />
                        {lectura}
                      </p>
                    )}
                  </div>
                )
              }
            </div>

            <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-tertiary">{tipoLabel}</p>
            <h1 class="mt-3 font-heading font-semibold text-3xl uppercase leading-[0.95] sm:text-5xl">{post.title}</h1>
            {descripcion && <p class="mt-5 text-lg leading-7 text-muted-foreground">{descripcion}</p>}

            {post.author?.name && <p class="mt-6 text-sm font-bold text-primary">Por {post.author.name}</p>}
          </div>
        </header>

        {
          imagenDestacada && (
            <figure data-reveal="fade" class="mx-auto mt-8 max-w-4xl px-4 lg:px-8">
              <img
                src={imagenDestacada}
                srcset={imagenDestacadaSrcset}
                sizes="(min-width: 896px) 896px, 100vw"
                alt={altImagen}
                class="aspect-[16/9] w-full rounded-xl object-cover grayscale shadow-lg"
                width="1400"
                height="788"
                loading="eager"
                fetchpriority="high"
              />
              {pieImagen && <figcaption class="mt-2 text-center text-xs text-muted-foreground">{pieImagen}</figcaption>}
            </figure>
          )
        }

        <div class="mx-auto max-w-3xl px-4 py-10 lg:px-8 lg:py-12">
          {body.length > 0 && <PortableText blocks={body} />}
        </div>

        {
          post.categorias && post.categorias.length > 0 && (
            <div class="mx-auto max-w-3xl px-4 pb-10 lg:px-8">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Categorías</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {post.categorias.map((c) => (
                  <a
                    href={`/categoria/${c.slug}/`}
                    class="rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-muted-foreground transition-colors hover:border-primary hover:text-primary"
                  >
                    {c.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          post.etiquetas && post.etiquetas.length > 0 && (
            <div class="mx-auto max-w-3xl px-4 pb-12 lg:px-8">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Temas</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {post.etiquetas.map((t) => (
                  <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-muted-foreground">
                    #{t.name}
                  </span>
                ))}
              </div>
            </div>
          )
        }
      </article>

      {
        masConversaciones.length > 0 && (
          <section class="bg-muted">
            <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
              <p data-reveal="up" class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary">Sigue leyendo</p>
              <h2 data-reveal="up" style="--reveal-index: 1" class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">Más conversaciones</h2>
              <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
                {masConversaciones.map((pub, i) => (
                  <EntrevistaCard pub={pub} chipAcento={i === 1} data-reveal="up" style={`--reveal-index: ${i % 3}`} />
                ))}
              </div>
            </div>
          </section>
        )
      }
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
