---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileNav from '../../components/MobileNav.astro';
import Icon from '../../components/Icon.astro';
import { getWebsAmigas } from '../../lib/sanity';
import { urlFor } from '../../lib/images';

const webs = await getWebsAmigas();
---

<Base
  title="Colaboraciones y webs amigas — El Fútbol Verdadero"
  description="Webs amigas y proyectos con los que colaboramos: fútbol base, formación de entrenadores y divulgación deportiva. Intercambio de tráfico y comunidad."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex flex-1 flex-col">
      <section class="flex-1 bg-muted">
        <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 py-12 lg:px-8">
          <div data-reveal="up" class="pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary">Comunidad</p>
            <h1 class="mt-2 font-heading font-semibold text-2xl uppercase sm:text-3xl">Webs amigas</h1>
            <p class="mt-3 max-2xl text-md leading-6 text-muted-foreground">
              Proyectos y webs con los que compartimos afición por el fútbol base. Visítalas y descubre contenido que también puede interesarte.
            </p>
          </div>

          {
            webs.length > 0 ? (
              <div class="mt-8 mb-10 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
                {webs.map((web, i) => (
                  <a
                    href={web.url}
                    target="_blank"
                    rel="noopener"
                    data-reveal="up"
                    style={`--reveal-index: ${i % 3}`}
                    class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-md transition hover:border-primary hover:shadow-lg"
                  >
                    <div class="flex aspect-[16/9] items-center justify-center overflow-hidden bg-muted p-6">
                      {web.logo?.asset?.url && (
                        <img
                          src={urlFor(web.logo.asset, 400)}
                          alt={`Logo de ${web.name}`}
                          class="max-h-full max-w-full object-contain transition duration-300 group-hover:scale-[1.05]"
                          width="400"
                          height="225"
                          loading="lazy"
                        />
                      )}
                    </div>
                    <div class="flex flex-1 flex-col p-6">
                      <h2 class="font-heading font-semibold text-xl uppercase leading-tight">{web.name}</h2>
                      {web.description && (
                        <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground">{web.description}</p>
                      )}
                      <span class="mt-auto inline-flex min-h-11 items-center gap-2 pt-5 text-sm font-bold text-primary">
                        Visitar web
                        <Icon name="arrow-up-right" class="text-lg transition group-hover:translate-x-1 group-hover:-translate-y-1" />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="mt-8 mb-10 text-sm text-muted-foreground">
                Todavía no hay webs amigas publicadas. Muy pronto.
              </p>
            )
          }

          <div
            data-reveal="up"
            class="mx-auto mt-auto w-full max-w-xl rounded-xl border-2 border-dashed border-border bg-card/40 px-6 py-5 text-center transition hover:border-primary"
          >
            <p class="text-sm text-muted-foreground">
              ¿Tienes un proyecto de fútbol base y quieres aparecer aquí?
              <a
                href="mailto:xabier.merino@elfutbolverdadero.com?subject=Quiero%20aparecer%20en%20Colaboraciones"
                class="ml-1 inline-flex items-center gap-1 font-bold text-primary hover:underline"
              >
                Escríbenos
                <Icon name="arrow-up-right" class="text-sm" />
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
