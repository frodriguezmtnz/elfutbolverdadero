---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ListaPublicaciones from '../../components/ListaPublicaciones.astro';
import Footer from '../../components/Footer.astro';
import MobileNav from '../../components/MobileNav.astro';
import {
  getTodasEntrevistas,
  getCategoriasConConteo,
  type CategoriaConteo,
  type Publicacion,
} from '../../lib/sanity';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const PAGE_SIZE = 24;
  const entrevistas = await getTodasEntrevistas();
  const categorias = (await getCategoriasConConteo(1)).slice(0, 6);
  const pages = paginate(entrevistas, { pageSize: PAGE_SIZE });
  return pages
    .filter((p) => p.params.page !== undefined && Number(p.params.page) > 1)
    .map((p) => ({
      params: { page: p.params.page as string },
      props: { page: p.props.page as Page<Publicacion>, categorias },
    }));
};

interface Props {
  page: Page<Publicacion>;
  categorias: CategoriaConteo[];
}

const { page, categorias } = Astro.props;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const prevURL = currentPage === 2 ? '/entrevistas/' : `/entrevistas/${currentPage - 1}/`;
const nextURL = currentPage < totalPages ? `/entrevistas/${currentPage + 1}/` : undefined;
---

<Base
  title={`Entrevistas (página ${currentPage}) — La Pizarra de los Mister · El Fútbol Verdadero`}
  description="Todas las entrevistas de fútbol base: entrenadores, directoras deportivas, psicólogos y analistas. Voces de banquillo."
  canonicalURL={`/entrevistas/${currentPage}/`}
  prevURL={prevURL}
  nextURL={nextURL}
>
  <div class="flex min-h-screen flex-col">
    <Header lecturaHref="/entrevistas/" />
    <main class="flex-1">
      <section class="bg-muted">
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div data-reveal="up" class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary-ink">
              Voces de banquillo
            </p>
            <h1 class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">
              La Pizarra de los Mister
            </h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
              Conversaciones con quienes forman el fútbol base: paciencia, contexto y muchísimo
              oficio.
            </p>
          </div>

          <ListaPublicaciones
            publicaciones={page.data}
            categorias={categorias}
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl="/entrevistas/"
          />
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
