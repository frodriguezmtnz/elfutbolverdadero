---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import ListaPublicaciones from '../../../components/ListaPublicaciones.astro';
import Footer from '../../../components/Footer.astro';
import MobileNav from '../../../components/MobileNav.astro';
import {
  getCategoriasConConteo,
  getEtiquetasConConteo,
  getPublicacionesPorEtiqueta,
  type EtiquetaConteo,
} from '../../../lib/sanity';
import { slugDeEtiqueta } from '../../../lib/texto';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const etiquetas = await getEtiquetasConConteo(1);
  return etiquetas.map((etiqueta) => ({
    params: { slug: slugDeEtiqueta(etiqueta.name, etiqueta.slug) },
    props: { etiqueta },
  }));
}

interface Props {
  etiqueta: EtiquetaConteo;
}

const { etiqueta } = Astro.props;
const todas = await getPublicacionesPorEtiqueta(etiqueta.name);
const total = todas.length;
const publicaciones = todas.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(total / PAGE_SIZE);
const nextURL =
  totalPages > 1 ? `/etiqueta/${slugDeEtiqueta(etiqueta.name, etiqueta.slug)}/2/` : undefined;
const categorias = (await getCategoriasConConteo(1)).slice(0, 6);
---

<Base
  title={`Tema: ${etiqueta.name} — El Fútbol Verdadero`}
  description={`Publicaciones de fútbol base sobre ${etiqueta.name} en El Fútbol Verdadero.`}
  nextURL={nextURL}
>
  <div class="flex min-h-screen flex-col">
    <Header lecturaHref="/entrevistas/" />
    <main class="flex-1">
      <section class="bg-muted">
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div data-reveal="up" class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary-ink">Tema</p>
            <h1 class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">
              #{etiqueta.name}
            </h1>
            <p class="mt-3 text-sm text-muted-foreground">
              {total}
              {total === 1 ? 'publicación' : 'publicaciones'}
            </p>
          </div>

          <ListaPublicaciones
            publicaciones={publicaciones}
            categorias={categorias}
            currentPage={1}
            totalPages={totalPages}
            baseUrl={`/etiqueta/${slugDeEtiqueta(etiqueta.name, etiqueta.slug)}/`}
            mensajeVacio="Todavía no hay publicaciones con este tema."
          />

          <div class="mt-10">
            <a
              class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-primary"
              href="/entrevistas/"
            >
              Ver todas las entrevistas
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
