---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import ListaPublicaciones from '../../../components/ListaPublicaciones.astro';
import Footer from '../../../components/Footer.astro';
import MobileNav from '../../../components/MobileNav.astro';
import {
  getCategoriasConConteo,
  getEtiquetasConConteo,
  getPublicacionesPorEtiqueta,
  type EtiquetaConteo,
  type Publicacion,
} from '../../../lib/sanity';
import { slugDeEtiqueta } from '../../../lib/texto';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const PAGE_SIZE = 24;
  const categoriasTop = (await getCategoriasConConteo(1)).slice(0, 6);
  const etiquetas = await getEtiquetasConConteo(1);
  const rutas = [];

  for (const etiqueta of etiquetas) {
    const publicaciones = await getPublicacionesPorEtiqueta(etiqueta.name);
    if (publicaciones.length <= PAGE_SIZE) continue;
    const slug = slugDeEtiqueta(etiqueta.name, etiqueta.slug);
    const pages = paginate(publicaciones, { pageSize: PAGE_SIZE, params: { slug } });
    for (const p of pages) {
      if (p.params.page !== undefined && Number(p.params.page) > 1) {
        rutas.push({
          params: p.params,
          props: { etiqueta, page: p.props.page as Page<Publicacion>, categorias: categoriasTop },
        });
      }
    }
  }
  return rutas;
};

interface Props {
  etiqueta: EtiquetaConteo;
  page: Page<Publicacion>;
  categorias: Awaited<ReturnType<typeof getCategoriasConConteo>>;
}

const { etiqueta, page, categorias } = Astro.props;
const slug = slugDeEtiqueta(etiqueta.name, etiqueta.slug);
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const prevURL = currentPage === 2 ? `/etiqueta/${slug}/` : `/etiqueta/${slug}/${currentPage - 1}/`;
const nextURL = currentPage < totalPages ? `/etiqueta/${slug}/${currentPage + 1}/` : undefined;
---

<Base
  title={`Tema: ${etiqueta.name} (página ${currentPage}) — El Fútbol Verdadero`}
  description={`Publicaciones de fútbol base sobre ${etiqueta.name} en El Fútbol Verdadero.`}
  canonicalURL={`/etiqueta/${slug}/${currentPage}/`}
  prevURL={prevURL}
  nextURL={nextURL}
>
  <div class="flex min-h-screen flex-col">
    <Header lecturaHref="/entrevistas/" />
    <main class="flex-1">
      <section class="bg-muted">
        <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
          <div data-reveal="up" class="border-b border-border pb-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-tertiary-ink">Tema</p>
            <h1 class="mt-2 font-heading font-semibold text-lg uppercase sm:text-3xl">
              #{etiqueta.name}
            </h1>
            <p class="mt-3 text-sm text-muted-foreground">
              {page.total}
              {page.total === 1 ? 'publicación' : 'publicaciones'}
            </p>
          </div>

          <ListaPublicaciones
            publicaciones={page.data}
            categorias={categorias}
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={`/etiqueta/${slug}/`}
            mensajeVacio="Todavía no hay publicaciones con este tema."
          />

          <div class="mt-10">
            <a
              class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-primary"
              href="/entrevistas/"
            >
              Ver todas las entrevistas
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>
    <MobileNav />
  </div>
</Base>
