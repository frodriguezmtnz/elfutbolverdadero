---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  robots?: string;
}
const {
  title,
  description = 'El fútbol del patio de colegio. Entrevistas y noticias de fútbol base.',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  image,
  robots,
} = Astro.props;

const siteName = 'Futbolverdadero';
const ogImage = image ? new URL(image, Astro.site) : new URL('/og.png', Astro.site);
// canonical siempre absoluta
const canonical = new URL(canonicalURL, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1B4D3E" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Estructura de datos JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: canonical,
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 300ms;
    animation-timing-function: ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>

<script>
  const FAILSAFE_DELAY = 1500;
  const BOTTOM_LINE = 0.9;
  let fallbackActive = false;
  let ticking = false;

  function strictlyInView(el: Element, threshold: number): boolean {
    const rect = el.getBoundingClientRect();
    const line = window.innerHeight * BOTTOM_LINE;
    const visible = Math.min(rect.bottom, line) - rect.top;
    return visible > 0 && visible / rect.height >= threshold;
  }

  function revealInView(): boolean {
    let revealed = false;
    for (const el of document.querySelectorAll('[data-reveal]:not(.is-revealed)')) {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('is-revealed');
        revealed = true;
      }
    }
    return revealed;
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      revealInView();
      if (fallbackActive && !document.querySelector('[data-reveal]:not(.is-revealed)')) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        fallbackActive = false;
      }
    });
  }

  function activateFallback() {
    if (fallbackActive) return;
    fallbackActive = true;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  function failsafe() {
    if (!document.documentElement.classList.contains('reveal-js')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.querySelector('[data-reveal].is-revealed')) return;
    const config = (window as any).__ASTRO_REVEAL__;
    const threshold = typeof config?.threshold === 'number' ? config.threshold : 0.15;
    let rescued = false;
    for (const el of document.querySelectorAll('[data-reveal]:not(.is-revealed)')) {
      if (strictlyInView(el, threshold)) {
        el.classList.add('is-revealed');
        rescued = true;
      }
    }
    if (rescued) activateFallback();
  }

  function schedule() {
    window.setTimeout(failsafe, FAILSAFE_DELAY);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedule, { once: true });
  } else {
    schedule();
  }
  document.addEventListener('astro:page-load', schedule);
</script>
