{
  "name": "elfutbolverdadero",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/legacy-redirects.mjs",
    "redirects:dry": "node scripts/legacy-redirects.mjs --dry-run",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "studio": "sanity dev --port 3333",
    "sanity": "sanity",
    "import:wp": "node scripts/import-wp.mjs",
    "export:wp-stats": "node scripts/export-wp-stats.mjs",
    "sanity:fix-entities": "node scripts/fix-sanity-entities.mjs",
    "sanity:fix-entities:apply": "node scripts/fix-sanity-entities.mjs --apply",
    "sanity:fix-titles": "node scripts/fix-sanity-titles.mjs",
    "sanity:fix-titles:apply": "node scripts/fix-sanity-titles.mjs --apply",
    "seed:entrenadores": "node scripts/seed-entrenadores.mjs",
    "seed:entrenadores:apply": "node scripts/seed-entrenadores.mjs --apply",
    "seed:entrenadores:limpiar": "node scripts/seed-entrenadores.mjs --limpiar --apply",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/block-tools": "^3.70.0",
    "@sanity/client": "^8.7.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-reveal": "^0.3.1",
    "dotenv": "^18.0.1",
    "medium-zoom": "^1.1.0",
    "reading-time": "^1.5.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3"
  }
}
