# Cliente de lectura de Astro (build)
SANITY_PROJECT_ID=s22b9256
SANITY_DATASET=production
# Solo necesario para escritura (import). NUNCA commitear el valor real.
SANITY_TOKEN=

# Sanity Studio (corre en el navegador; usa import.meta.env)
SANITY_STUDIO_PROJECT_ID=s22b9256
SANITY_STUDIO_DATASET=production

# Hosts extra permitidos en astro dev (separados por comas)
DEV_ALLOWED_HOSTS=

# Umami Cloud: Settings de la web → Website ID (UUID). Vacío = no se inyecta el script.
# En Vercel: variable de entorno (tipo Config) en Production y Preview.
PUBLIC_UMAMI_WEBSITE_ID=

# Para scripts/export-wp-stats.mjs — auth contra la API de WordPress.com:
# opción A) token OAuth (developer.wordpress.com → crear app → scope admin.scope.stats)
# opción B) cookie de sesión del navegador logueado en wordpress.com (F12 → Network → Cookie)
WP_STATS_TOKEN=
WP_COOKIE=

# ── Zona Futbolverdadero Entrenadores (SSR: login + suscripción) ──
# Solo necesarias para las rutas on-demand (/entrenadores/*). En producción
# van como Secret en Vercel; el sitio público no las usa en build.

# Supabase: proyecto → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: SOLO servidor (webhook de sincronización). NUNCA exponer ni en el HTML.
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (Merchant of Record, 12 €/año):
# API key → Developer → API credentials; secreto → Developer → Webhooks
LS_API_KEY=
LS_WEBHOOK_SECRET=
LS_STORE_ID=
# Variant ID del producto de suscripción anual
LS_VARIANT_ID=
# URL del portal de cliente de Lemon Squeezy (autogestión de suscripción/facturas).
# Opcional: sin valor, el panel no muestra el enlace.
LS_PORTAL_URL=
# LS_TEST_MODE=1 para checkout en modo prueba (solo Preview/dev; nunca en Production)
LS_TEST_MODE=

# Firma de la cookie de sesión (cadena aleatoria larga, p. ej. openssl rand -hex 32)
SESSION_SECRET=

# SMTP (Supabase · Site Settings → SMTP settings) para el email de bienvenida:
# HOST p. ej. smtp.eu-central-1.aws.supabase.com · PORT 465 (587 si el proveedor solo ofrece STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=postgres@tu-proyecto.supabase.co
SMTP_PASS=
# Opcional: remitente visible (si se omite, se usa el email de contacto de la web)
EMAIL_FROM=
